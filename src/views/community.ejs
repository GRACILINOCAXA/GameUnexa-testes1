<%- include('partials/head', { title: 'Comunidade' }) %>

<h1 style="margin-bottom: 8px;">Comunidade de Jogadores</h1>
<p style="color: var(--text-secondary); margin-bottom: 24px;">
  Encontre outros jogadores, veja bibliotecas e acompanhe o que seus amigos estão jogando.
</p>

<form class="search-bar" action="/community" method="GET">
  <input type="text" name="q" placeholder="Buscar jogador pelo nickname..." value="<%= search %>">
  <button type="submit" class="btn btn-primary">Buscar</button>
</form>

<% if (friendRequests.length > 0) { %>
  <section class="friend-requests">
    <h2 class="section-title">Pedidos de amizade recebidos</h2>
    <% friendRequests.forEach(request => { %>
      <div class="friend-request-item">
        <a href="/profile/<%= request.username %>" class="player-name">@<%= request.username %></a>
        <div class="friend-request-actions">
          <form action="/community/friends/accept/<%= request.id %>" method="POST">
            <button type="submit" class="btn btn-primary">Aceitar</button>
          </form>
          <form action="/community/friends/decline/<%= request.id %>" method="POST">
            <button type="submit" class="btn btn-secondary">Recusar</button>
          </form>
        </div>
      </div>
    <% }) %>
  </section>
<% } %>

<% if (players.length === 0) { %>
  <p style="color: var(--text-muted);">Nenhum outro jogador encontrado.</p>
<% } else { %>
  <div class="players-grid">
    <% players.forEach(player => { %>
      <div class="player-card">
        <div>
          <div class="player-card-header">
            <a href="/profile/<%= player.username %>" class="player-name">@<%= player.username %></a>
            <% if (player.sharedGamesCount > 0) { %>
              <span class="shared-badge"><%= player.sharedGamesCount %> em comum</span>
            <% } %>
          </div>
          <p class="game-meta" style="margin-top: 6px;">
            <% if (player.canViewLibrary) { %>
              <%= player.gamesCount %> jogos na biblioteca
            <% } else { %>
              Biblioteca privada
            <% } %>
          </p>
        </div>

        <a href="/profile/<%= player.username %>" class="btn btn-secondary">Ver Perfil</a>

        <% if (player.isFriend) { %>
          <span class="status-badge">Amigos</span>
        <% } else if (player.hasIncomingRequest) { %>
          <div class="friend-request-actions">
            <form action="/community/friends/accept/<%= player.id %>" method="POST">
              <button type="submit" class="btn btn-primary">Aceitar</button>
            </form>
            <form action="/community/friends/decline/<%= player.id %>" method="POST">
              <button type="submit" class="btn btn-secondary">Recusar</button>
            </form>
          </div>
        <% } else if (player.hasOutgoingRequest) { %>
          <form action="/community/friends/cancel/<%= player.id %>" method="POST">
            <input type="hidden" name="redirectTo" value="/community?q=<%= encodeURIComponent(search) %>">
            <button type="submit" class="btn btn-secondary">Cancelar pedido</button>
          </form>
        <% } else { %>
          <form action="/community/friends/request/<%= player.id %>" method="POST">
            <input type="hidden" name="redirectTo" value="/community?q=<%= encodeURIComponent(search) %>">
            <button type="submit" class="btn btn-primary">Adicionar amigo</button>
          </form>
        <% } %>

        <div style="display: flex; gap: 8px;">
          <form action="/community/follow/<%= player.id %>" method="POST" style="flex: 1;">
            <input type="hidden" name="redirectTo" value="/community?q=<%= encodeURIComponent(search) %>">
            <button type="submit" class="btn btn-full <%= player.isFollowing ? 'btn-secondary' : 'btn-primary' %>">
              <% if (player.isFollowing) { %>
                <i class="ph-bold ph-check"></i> Seguindo
              <% } else { %>
                <i class="ph ph-user-plus"></i> Seguir
              <% } %>
          </button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>